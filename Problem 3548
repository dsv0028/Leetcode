class Solution {
public:
    typedef long long ll;
    ll total = 0;

    bool checkhorcuts(vector<vector<int>>& grid){
        int m = grid.size();
        int n = grid[0].size();
        ll top = 0;
        unordered_set<ll> st;
        for(int i = 0; i <= m - 2; i++){
            for(int j = 0; j < n; j++){
                top += grid[i][j];
                st.insert(grid[i][j]);
            }
            ll bottom = total - top;
            ll diff = top - bottom;
            if(diff == 0) return true;
            if(diff == (ll)grid[0][0]) return true;
            if(diff == (ll)grid[0][n - 1]) return true;
            if(diff == (ll)grid[i][0]) return true;
            if(i > 0 && n > 1 && st.count(diff)) return true;
        }
        return false;
    }

    bool canPartitionGrid(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        total = 0;
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                total += grid[i][j];
            }
        }
        //horizontal cuts
        if(checkhorcuts(grid)) return true;
        reverse(grid.begin(), grid.end());
        if((checkhorcuts(grid))) return true;
        reverse(grid.begin(), grid.end());

        //checking vertical cuts by horizontal method
        //taking transpose row becomes coumn && column becomes row
        vector<vector<int>> transposegrid(n, vector<int>(m));
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                transposegrid[j][i] = grid[i][j];
            }
        }

        if(checkhorcuts(transposegrid)) return true;
        reverse(transposegrid.begin(), transposegrid.end());
        if((checkhorcuts(transposegrid))) return true;

        return false;
    }
};
