class Solution {
public:
    int numSteps(string s) {
        int cnt = 0;

        while (s != "1") {   
            if (s.back() == '0') {   
                s.pop_back();       
            } 
            else {                  
                int j = s.size() - 1;

                while (j >= 0 && s[j] == '1') {
                    s[j] = '0';
                    j--;
                }

                if (j >= 0) {
                    s[j] = '1';
                } else {
                    s = "1" + s;    
                }
            }
            cnt++;
        }
        return cnt;
    }
};
