class Solution {
public:
    bool solve(string s, vector<string>& dict){
        int maxi = INT_MAX;
        for(string ss: dict){
            int cnt = 0;
            for(int i = 0; i < min(s.size(), ss.size()); i++){
                if(s[i] != ss[i]){
                    cnt++;
                }
            }
            maxi = min(maxi, cnt);
        }
        return maxi <= 2;
    }

    vector<string> twoEditWords(vector<string>& queries, vector<string>& dictionary) {
        vector<string> ans;
        for(string it: queries){
            bool check = solve(it, dictionary);
            if(check){
                ans.push_back(it);
            }
        }
        return ans;
    }
};
