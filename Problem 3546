class Solution {
public:
    bool canPartitionGrid(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();
        long long sum = 0;
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                sum += grid[i][j];
            }
        }
        long long rs = 0;
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                rs += grid[i][j];
            }
            if(rs == (sum - rs)) return true; 
        }
        long long cs = 0;
        for(int i = 0; i < n; i++){
            for(int j = 0; j < m; j++){
                cs += grid[j][i];
            }
            if(cs == (sum - cs)) return true;
        }
        return false;
    }
};
