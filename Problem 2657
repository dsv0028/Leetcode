class Solution {
public:
    vector<int> findThePrefixCommonArray(vector<int>& A, vector<int>& B) {
        unordered_map<int, int> mp;
        int n =  A.size();
        vector<int> ans(n, 0);

        for(int i = 0; i < n; i++){
            mp[A[i]]++;
            mp[B[i]]++;

            int prev = (i == 0 ? 0 : ans[i-1]);

            if(mp[A[i]] == 2 && mp[B[i]] == 2 && A[i]!=B[i]){
                ans[i] = prev + 2;
            }
            else if(mp[A[i]] == 2 && mp[B[i]] == 2 && A[i]==B[i]){
                ans[i] = prev + 1;
            }
            else if(mp[A[i]] == 2 || mp[B[i]] == 2){
                ans[i] = prev + 1;
            }
            else{
                ans[i] = prev;
            }
        }

        return ans;
    }
};
