class Solution {
public:
    int minimumDeletions(string s) {
        int n = s.size();
        vector<int> arr(n, 0);
        int ac = 0;

        for (int i = n - 1; i >= 0; i--) {
            arr[i] = ac;
            if (s[i] == 'a') ac++;
        }

        int ans = n;
        int bc = 0;
        for (int i = 0; i < n; i++) {
            ans = min(arr[i] + bc, ans);
            if (s[i] == 'b') bc++;
        }

        return ans;
    }
};
