
class Solution {
public:
    vector<int> minBitwiseArray(vector<int>& nums) {
        vector<int> ans;

        for (int x : nums) {
            // If x is even, impossible
            if (x % 2 == 0) {
                ans.push_back(-1);
            } else {
                // Minimum a such that a | (a + 1) = x
                ans.push_back(x & (x - 1));
            }
        }

        return ans;
    }
};
