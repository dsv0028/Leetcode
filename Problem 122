class Solution {
public:
    vector<vector<int>> t;

    int solve(vector<int>& prices, int buy, int n, int ind){
        if(ind == n){
            return 0;
        }

        if(t[ind][buy] != -1){
            return t[ind][buy];
        }

        int profit = 0;

        if(buy){
            profit = max(-prices[ind] + solve(prices, 0, n, ind+1),
                         solve(prices, 1, n, ind+1));
        }
        else{
            profit = max(prices[ind] + solve(prices, 1, n, ind+1),
                         solve(prices, 0, n, ind+1));
        }

        return t[ind][buy] = profit;
    }

    int maxProfit(vector<int>& prices) {
        int n = prices.size();
        t.assign(n, vector<int>(2, -1)); 
        return solve(prices, 1, n, 0);
    }
};
