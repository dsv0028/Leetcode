class Solution {
public:
    int countDigitOccurrences(vector<int>& nums, int digit) {
        int cnt = 0;
        for(int it: nums){
            while(it > 0){
                if(it % 10 == digit){
                    cnt++;
                }
                it = it/10;
            }
        }
        return cnt;
    }
};
