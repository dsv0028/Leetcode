class Solution {
public:
    int maxNumberOfBalloons(string text) {
        unordered_map<char, int> mp = {{'b',0},{'a',0},{'l',0},{'o',0},{'n',0}};
        int n = text.size();
        for(int i = 0; i <n; i++){
            if(mp.count(text[i])){
                mp[text[i]]++;
            }
        }
        int ans = INT_MAX;
        for(auto it: mp){
            int a = it.second;
            if(it.first == 'l' || it.first == 'o'){
                a = a/2;
            }
            ans = min(ans, a);
        }
        return ans;
    }
};
