class Solution {
public:
    vector<int> minBitwiseArray(vector<int>& nums) {
        vector<int> ans;
        int n = nums.size();

        for (int i = 0; i < n; i++) {
            int found = -1;

            for (int a = 0; a <= nums[i]; a++) {
                if ( (a | (a + 1)) == nums[i] ) {
                    found = a;
                    break;  
                }
            }

            ans.push_back(found);
        }

        return ans;
    }
};
