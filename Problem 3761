class Solution {
public:
    int reverse(int n){
        int ans = 0;
        while(n > 0){
            int dig = n % 10;
            ans = ans * 10 + dig;  
            n = n / 10;             
        }
        return ans;
    }

    int minMirrorPairDistance(vector<int>& nums) {
        unordered_map<int, int> mp;

        mp[reverse(nums[0])] = 0;

        int res = INT_MAX;

        for(int j = 1; j < nums.size(); j++){
            if(mp.count(nums[j])){
                res = min(res, j - mp[nums[j]]);
            }
            mp[reverse(nums[j])] = j;
        }

        return (res == INT_MAX) ? -1 : res;
    }
};
