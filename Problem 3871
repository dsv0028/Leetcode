class Solution {
public:
    long long countCommas(long long n) {
        long long ans= 0;
        for(long long i = 1; i <= 6; i++){
            long long l = pow(10,3*i);
            if(l > n) break;

            long long r=min(n, (long long)pow(10,3*(i+1))-1);
            long long c=r-l+1;

            ans += c*i;
        }
        return ans;
    }
};
