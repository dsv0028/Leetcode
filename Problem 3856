class Solution {
public:
    string trimTrailingVowels(string s) {
        
        int n = s.size();
        int idx = n;
        for(int i = n-1; i >= 0; i--){
            if(s[i] == 'a' || s[i] == 'e' || s[i] == 'o' || s[i] == 'u' || s[i] == 'i'){
                idx = i;
            }
            else{
                break;
            }
        }
        return s.substr(0, idx);
    }
};
