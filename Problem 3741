class Solution {
public:
    int minimumDistance(vector<int>& nums) {
        int n = nums.size();
        unordered_map<int, vector<int>> mp;
        int ans = INT_MAX;
        bool flag = false;

        for (int i = 0; i < n; i++) {
            int a = nums[i];

            if (mp.count(a)) {
                auto& b = mp[a];

                if (b.size() == 2) {
                    int dis = 2 * (i - b[0]);
                    ans = min(ans, dis);
                    flag = true;
                }
                b.push_back(i);
                if (b.size() > 2) {
                    b.erase(b.begin());
                }
            } else {
                mp[a] = {i};
            }
        }
        if (flag) {
            return ans;
        }
        return -1;
    }
};
