class Solution {
public:
    vector<int> separateDigits(vector<int>& nums) {
        string s = "";
        int n = nums.size();
        for(int i = 0; i < n; i++){
            s += to_string(nums[i]);
        }
        vector<int> ans;
        for(int i = 0; i < s.size(); i++){
            ans.push_back(s[i] - '0');
        }
        return ans;
    }
};
