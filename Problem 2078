class Solution {
public:
    int maxDistance(vector<int>& colors) {
        int n = colors.size();
        int ans = 0;

        int i = 0, j = n - 1;

        while (j >= 0 && colors[j] == colors[0]) {
            j--;
        }
        if (j >= 0) ans = max(ans, j);

        i = 0;
        while (i < n && colors[i] == colors[n - 1]) {
            i++;
        }
        if (i < n) ans = max(ans, n - 1 - i);

        return ans;
    }
};
