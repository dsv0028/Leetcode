class Solution {
public:
    int solve(vector<int>& nums, int n, int sum, int ff, int ans){
        if(n <= 0){
            return ans;
        }

        ff = ff - nums[n]*(nums.size()-1) + (sum - nums[n]);
        ans = max(ans, ff);
        return solve(nums, n - 1, sum, ff, ans);
    }

    int maxRotateFunction(vector<int>& nums) {
        int n = nums.size();
        if(n == 1) return 0;
        int sum = 0;
        for(int i = 0; i < n; i++){
            sum += nums[i];
        }
        int ff = 0;
        for(int i = 0; i < n; i++){
            ff += nums[i]*i;
        }
        int ans = INT_MIN;
        return solve(nums, n-1, sum, ff, ff);
    }
};
