class Solution {
public:
    vector<int> rotateElements(vector<int>& nums, int k) {
        vector<int> arr;
        for(int it: nums){
            if(it >= 0){
                arr.push_back(it);
            }
        }
        int n = arr.size();
        if(n <= 1) return nums;

        k = k % n;

        vector<int> arr2;
        for(int i = k; i < n; i++){
            arr2.push_back(arr[i]);
        }
        for(int i = 0; i < k; i++){
            arr2.push_back(arr[i]);
        }

        int a = 0;
        for(int i = 0; i < nums.size(); i++){
            if(nums[i] >= 0){
                nums[i] = arr2[a];
                a++;
            }
        }
        return nums;
    }
};
