class Solution {
public:
    int findMin(vector<int>& nums) {
        int n = nums.size();
        int i = 0, j = n - 1;

        while(i < j) {
            int mid = i + (j - i) / 2;

            if(mid < n - 1 && nums[mid] > nums[mid + 1]) {
                return nums[mid + 1];
            }

            if(mid > 0 && nums[mid] < nums[mid - 1]) {
                return nums[mid];
            }

            if(nums[mid] < nums[j]) {
                j = mid - 1;
            }
            else if(nums[mid] > nums[j]) {
                i = mid + 1;
            }
            else {
                j--;
            }
        }

        return nums[i];
    }
};
