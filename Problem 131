class Solution {
public:
    vector<vector<vector<string>>> dp;

    bool is_palindrome(string &s, int l, int r) {
        while (l < r) {
            if (s[l] != s[r]) return false;
            l++, r--;
        }
        return true;
    }

    vector<vector<string>> solve(string &s, int i) {
        if (i == s.size()) {
            return {{}};
        }

        if (!dp[i].empty()) {
            return dp[i];
        }

        vector<vector<string>> res;

        for (int k = i; k < s.size(); k++) {
            if (is_palindrome(s, i, k)) {
                string part = s.substr(i, k - i + 1);

                auto next = solve(s, k + 1);
                for (auto &v : next) {
                    vector<string> temp;
                    temp.push_back(part);
                    temp.insert(temp.end(), v.begin(), v.end());
                    res.push_back(temp);
                }
            }
        }

        return dp[i] = res;
    }

    vector<vector<string>> partition(string s) {
        dp.resize(s.size());
        return solve(s, 0);
    }
};


class Solution {
public:
    bool is_palindrome(string s){
        int l = 0, r = s.size() - 1;
        while(l < r){
            if(s[l] != s[r]){
                return false;
            }
            l++;
            r--;
        }
        return true;
    }

    void solve(string s, vector<string>& partition, vector<vector<string>>& ans) {
        if (s.size() == 0) {
            ans.push_back(partition);
            return;
        }

        for (int i = 0; i < s.size(); i++) {
            string part = s.substr(0, i + 1);
            if (is_palindrome(part)) {
                partition.push_back(part);
                solve(s.substr(i + 1), partition, ans);
                partition.pop_back();
            }
        }
    }

    vector<vector<string>> partition(string s) {
        vector<vector<string>> ans;
        vector<string> partition;
        solve(s, partition, ans);
        return ans;
    }
};
