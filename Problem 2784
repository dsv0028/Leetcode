class Solution {
public:
    bool isGood(vector<int>& nums) {
        int n = nums.size() - 1;
        unordered_map<int, int> mp;

        for (int x : nums) {
            mp[x]++;
        }

        for (int i = 1; i < n; i++) {
            if (mp[i] != 1) {
                return false;
            }
        }

        if (mp[n] != 2) {
            return false;
        }
        return true;
    }
};
