class Solution {
public:
    double separateSquares(vector<vector<int>>& squares) {
        int n = squares.size();
        double ta = 0;
        double high = INT_MIN;
        double low = INT_MAX;

        for(int i = 0; i < n; i++){
            double side = squares[i][2];
            ta += side * side;

            low  = min(low,  (double)squares[i][1]);
            high = max(high, (double)squares[i][1] + side);
        }

        double t = ta / 2.0;

        for (int i = 0; i < 100; i++) {
            double mid = (low + high) / 2.0;
            double areaBelow = 0;

            for (auto &sq : squares) {
                double y = sq[1];
                double side = sq[2];

                if (mid <= y) continue;
                else if (mid >= y + side)
                    areaBelow += side * side;
                else
                    areaBelow += side * (mid - y);
            }

            if (areaBelow < t)
                low = mid;
            else
                high = mid;
        }

        return low;
    }
};
