class Solution {
public:
    int minSetSize(vector<int>& arr) {
        int n = arr.size();
        unordered_map<int, int> mp;
        for (int it : arr) {
            mp[it]++;
        }

        priority_queue<int> pq;
        for(auto it: mp){
            pq.push(it.second);
        }

        int ans = 0;
        int a = 0;
        for(int i = 0; i < mp.size(); i++){
            a += pq.top();
            pq.pop();
            ans++;
            if(a >= n/2){
                break;
            }
        }

        // set<int> st;
        // int a = 0;
        // for (auto it : mp) {
        //     st.insert(it.first);
        //     a += it.second;
        //     if (a < n / 2) {
        //         break;
        //     }
        // }
        // return st.size();
        return ans;
    }
};
