class Solution {
public:
    int solve(int n){
        string s = to_string(n);
        int a = s.size();
        int cnt = 0;

        for(int i = 1 ; i < a - 1; i++){     
            int prev = s[i-1] - '0';
            int curr = s[i] - '0';
            int next = s[i+1] - '0';

            if ((prev > curr && next > curr) || (prev < curr && curr > next)) {
                cnt++;
            }
        }
        return cnt;
    }

    int totalWaviness(int num1, int num2) {
        int ans = 0;
        for(int i = num1; i <= num2; i++){
            ans += solve(i);
        }
        return ans;
    }
};
