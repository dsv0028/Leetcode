class Solution {
public:
    int minRemoval(vector<int>& nums, int k) {
        sort(nums.begin(), nums.end());
        int n = nums.size();

        int ans = 0;
        int i = 0;

        for (int j = 0; j < n; j++) {
            while ((long long)nums[i] * k < nums[j]) {
                i++;
            }
            ans = max(ans, j - i + 1);
        }

        return n - ans;
    }
};
 
