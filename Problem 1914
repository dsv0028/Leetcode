class Solution {
public:
    void reverse(vector<int>& nums, int start, int end) {
        while (start < end) {
            swap(nums[start], nums[end]);
            start++;
            end--;
        }
    }

    void rotateLeft(vector<int>& nums, int k) {
        int n = nums.size();
        k = k % n;

        reverse(nums, 0, k - 1);
        reverse(nums, k, n - 1);
        reverse(nums, 0, n - 1);
    }

    vector<vector<int>> rotateGrid(vector<vector<int>>& grid, int k) {
        int i = 0, j = 0;
        int m = grid.size() - 1;
        int n = grid[0].size() - 1;
        while (i < m && j < n) {
            vector<int> res;
            int a = i, b = j, c = m, d = n;
            for (int col = b; col <= d; col++) {
                res.push_back(grid[a][col]);
            }

            for (int row = a + 1; row <= c; row++) {
                res.push_back(grid[row][d]);
            }

            for (int col = d - 1; col >= b; col--) {
                res.push_back(grid[c][col]);
            }

            for (int row = c - 1; row > a; row--) {
                res.push_back(grid[row][b]);
            }

            rotateLeft(res, k);

            int idx = 0;

            // top row
            for (int col = b; col <= d; col++) {
                grid[a][col] = res[idx++];
            }
            a++;

            // right column
            for (int row = a; row <= c; row++) {
                grid[row][d] = res[idx++];
            }
            d--;

            // bottom row
            for (int col = d; col >= b; col--) {
                grid[c][col] = res[idx++];
            }
            c--;

            // left column
            for (int row = c; row >= a; row--) {
                grid[row][b] = res[idx++];
            }
            b++;

            i++;
            j++;
            n--;
            m--;
        }
        return grid;
    }
};
