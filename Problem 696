class Solution {
public:
    int countBinarySubstrings(string s) {
        int prev = 0, curr = 1, ans = 0;

        for(int i = 1; i < s.size(); i++){
            if(s[i-1] == s[i]){
                curr++;
            }
            else{
                prev = curr;
                curr = 1;
            }
            if(curr <= prev){
                ans++;
            }
        }
        return ans;
    }
};
