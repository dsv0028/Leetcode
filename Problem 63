class Solution {
public:
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int m = obstacleGrid.size();        
        int n = obstacleGrid[0].size();    
        
        vector<vector<int>> t(m+1, vector<int>(n+1, 0));

        if(obstacleGrid[0][0] == 1){
            return 0;
        }

        t[0][0] = 1;

        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){

                if(obstacleGrid[i][j] == 1){
                    t[i][j] = 0;
                }
                else{
                    if(i > 0){
                        t[i][j] += t[i - 1][j];
                    }
                    if(j > 0){
                        t[i][j] += t[i][j - 1];
                    }
                }
            }
        }
        return t[m -1][n - 1];
    }
};
