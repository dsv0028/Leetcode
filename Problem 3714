class Solution {
public:
    int solve(string s, char ch1, char ch2){
        int n = s.size();
        unordered_map<int, int> diff;
        int count1 = 0, count2 = 0;
        int maxL = 0;

        for(int i = 0; i < n; i++){
            if(s[i] != ch1 && s[i] != ch2){
                diff.clear();
                count1 = 0;
                count2 = 0;
                continue;
            }

            if(s[i] == ch1){
                count1++;
            }
            if(s[i] == ch2){
                count2++;
            }

            if(count1 == count2){
                maxL = max(maxL, count1 + count2);
            }

            int d = count1 - count2;
            if(diff.count(d)){
                maxL = max(maxL, i - diff[d]);
            }
            else{
                diff[d] = i;
            }
        }
        return maxL;
    }

    int longestBalanced(string s) {
        int n = s.size();
        int maxL = 0;

        //case1
        int count = 1;
        for(int i = 1; i < n; i++){
            if(s[i - 1] == s[i]){
                count++;
            }
            else{
                maxL = max(maxL, count);
                count = 1;
            }
        }
        maxL = max(maxL, count);

        //case2
        maxL = max(maxL, solve(s, 'a', 'b'));
        maxL = max(maxL, solve(s, 'a', 'c'));
        maxL = max(maxL, solve(s, 'b', 'c'));


        //case3
        int countA = 0;
        int countB = 0;
        int countC = 0;
        unordered_map<string, int> diff;

        for(int i = 0; i < n; i++){
            if(s[i] == 'a'){
                countA++;
            }
            if(s[i] == 'b'){
                countB++;
            }
            if(s[i] == 'c'){
                countC++;
            }

            if(countA == countB && countA == countC){
                maxL = max(maxL, countA + countB + countC);
            }

            int dAB = countA - countB;
            int dAC = countA - countC;

            string key = to_string(dAB) + "_" + to_string(dAC);

            if(diff.count(key)){
                maxL = max(maxL, i - diff[key]);
            }
            else{
                diff[key] = i;
            }
        }
        return maxL;
    }
};
