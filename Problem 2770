class Solution {
public:
    int maximumJumps(vector<int>& nums, int target) {
        int n = nums.size();
        vector<int> dp(n, -1);
        dp[n - 1] = 0;

        int i = 0;
        for (int i = n - 2; i >= 0; i--) {
            for (int j = i + 1; j < n; j++) {
                if (abs(nums[j] - nums[i]) <= target) {
                    int jump = dp[j];
                    if (jump != -1) {
                        dp[i] = max(dp[i], jump + 1);
                    }
                }
            }
        }
        return dp[0];
    }
};
