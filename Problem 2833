class Solution {
public:
    int furthestDistanceFromOrigin(string moves) {
        int r = 0, l = 0, g = 0;
        int ans = 0;
        for(int i = 0; i < moves.size(); i++){
            if(moves[i] == 'L'){
                l++;
            }
            else if(moves[i] == 'R'){
                r++;
            }
            else{
                g++;
            }
        }
        ans = abs(l-r)+g;
        return ans;
    }
};
