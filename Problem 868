class Solution {
public:
    int binaryGap(int n) {
        int high = log2(n);

        bitset<32> s(n);
        int last = -1;
        int ans = 0;
        for(int i = 0; i <= high; i++){
            if(s[i] == 1){
                if(last != -1){
                    ans = max(ans, i - last);
                }
                last = i;
            }
        }
        return ans;
    }
};
