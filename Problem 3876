class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int me = INT_MAX;
        int mo = INT_MAX;
        int n = nums1.size();

        for (int i = 0; i < n; i++) {
            if (nums1[i] % 2 == 0) {
                me = min(me, nums1[i]);
            } else {
                mo = min(mo, nums1[i]);
            }
        }

        bool ae = true;
        bool ao = true;
        for (int it : nums1) {
            if (it % 2 == 1) {
                if (mo >= it) {
                    ae = false;
                    break;
                }
            }
        }

        for (int it : nums1) {
            if (it % 2 == 0) {
                if (mo >= it) {
                    ao = false;
                    break;
                }
            }
        }
        bool ans = ae || ao;
        return ans;
    }
};
